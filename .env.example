# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp Notifications (CallMeBot)
# Country code + number without '+' or spaces (e.g., 201111232340 for Egypt)
WHATSAPP_PHONE=201111232340
# The API key received after sending "I allow callmebot to send me messages" on WhatsApp
WHATSAPP_APIKEY=your_callmebot_api_key
